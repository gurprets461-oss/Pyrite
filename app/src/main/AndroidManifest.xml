<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- pip, and user programs that use the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pyrite">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Each run gets its own process: Stop = kill it, and a crash can't take down the UI. -->
        <service
            android:name=".runner.PythonService"
            android:exported="false"
            android:process=":py" />
        <!-- The REPL lives in its own process, so it survives script runs. -->
        <service
            android:name=".runner.ReplService"
            android:exported="false"
            android:process=":repl" />
        <service
            android:name=".runner.PipService"
            android:exported="false"
            android:process=":pip" />
        <service
            android:name=".runner.AnalysisService"
            android:exported="false"
            android:process=":analysis" />
    </application>

</manifest>
